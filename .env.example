# Signal Feedback Backend Configuration

# Server Port
PORT=3001

# PostgreSQL Connection String (If empty, defaults to embedded PostgreSQL PGlite engine)
# Example: postgresql://username:password@localhost:5432/signal_db
DATABASE_URL=

# PostgreSQL SSL Connection (set to 'true' if connecting to managed DB like AWS RDS, Neon, Supabase)
DB_SSL=false

# Connection Pool Limit
DB_POOL_MAX=10

# Secret key required for administrative operations (triage, feedback enumeration)
ADMIN_SECRET_KEY=signal_admin_secret_key_demo_2026

# Default Public Project Key seeded on initial migration
DEFAULT_PROJECT_KEY=prj_live_signal_demo_default

# Allowed Origins for CORS (comma-separated or * for development)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# Salt for Client IP Hashing (used for privacy-preserving rate limiting)
RATE_LIMIT_SALT=signal_rate_limiter_salt_secret_change_in_prod

# Trust Reverse Proxy Headers (set true if behind Cloudflare, Nginx, or AWS ALB)
TRUST_PROXY=false
